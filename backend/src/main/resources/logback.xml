<configuration>
    <!-- Texto legible en local; el JSON de producción llega con el despliegue del piloto (P-18) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- %X{call-id}: identificador del pedido, vacío fuera de un pedido (11 · Backend §8) -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} %X{call-id} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>

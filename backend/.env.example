# Solo desarrollo local. Copiar como .env y elegir una contraseña propia.
APP_ENV=local
HOST=127.0.0.1
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pasitos
DB_USER=pasitos
DB_PASSWORD=
JWT_SECRET=
TERMS_VERSION=1
# Decisión de trabajo del 22/11/2026: 10 pedidos por minuto por conexión en /auth/*.
AUTH_RATE_LIMIT=10


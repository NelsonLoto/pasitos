DB_HOST=localhost
DB_PORT=5433
DB_NAME=pasitos
DB_USER=pasitos_dev
DB_PASSWORD=pasitos_dev_local

JWT_SECRET=dev-secret-change-me
JWT_ISSUER=pasitos-backend
JWT_AUDIENCE=pasitos-app

# Versión vigente de los términos (RN-CTA-02). Opcional: por defecto es "1".
# TERMS_VERSION=1

# Emails de cuenta (verificación, recuperación de contraseña). Por defecto apuntan a Mailpit
# (localhost:1025, sin usuario ni contraseña): no hace falta configurarlos en desarrollo local.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-responder@pasitos.ar

# Para armar los links de los emails hacia /web/... (ADR-27). Opcional: por defecto apunta al
# backend local.
# PUBLIC_BASE_URL=http://localhost:8080

<?xml version="1.0" encoding="utf-8"?>
<!--
   Copia en la nube y traspaso a otro teléfono desde Android 12. Mismas exclusiones que
   backup_rules.xml: la base local y sus claves no se pueden descifrar fuera de este teléfono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
        <exclude domain="sharedpref" path="pasitos_keyset.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
        <exclude domain="sharedpref" path="pasitos_keyset.xml" />
    </device-transfer>
</data-extraction-rules>
